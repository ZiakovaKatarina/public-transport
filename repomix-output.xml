    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }

    async function search_connections() {
        if (search_controller) {
            search_controller.abort();
        }

        search_controller = new AbortController();
        const signal = search_controller.signal;

        document.getElementById('trasy').innerHTML = ``;
        if (change_start) {
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
        }

        if (change_end) {
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
        }

        const start = selected_locations[0];
        const end = selected_locations[1];

        document.getElementById('trasa').innerText = '';
        if ((start[0] == null || start[1] == null) && (end[0] == null || end[1] == null)) {
            document.getElementById('trasa').innerText = 'Prosím, vyberte začiatočnú a koncovú polohu.';
            return;
        } else if (start[0] == null || start[1] == null) {
            document.getElementById('trasa').innerText = 'Prosím, vyberte začiatočnú polohu.';
            return;
        } else if (end[0] == null || end[1] == null) {
            document.getElementById('trasa').innerText = 'Prosím, vyberte koncovú polohu.';
            return;
        } else if (start[0] == end[0] && start[1] == end[1]) {
            document.getElementById('trasa').innerText = 'Začiatočná a koncová poloha sú rovnaké. Pre vyhľadanie spojenia zadajte iné polohy.';
            return;
        }

        const schovat = ["buttons_for_locations", "buttons_for_current_locations", "datum_cesty", "max_prestupov", "nejaky_div", "text_datum", "time_mode", "text_pocet_prestupov", "time", "text_vzdialenost_peso", "nastavit_vzdialenost", "podme_hladat", "trasa"];
        for (let i = 0; i < schovat.length; i++) {
            document.getElementById(schovat[i]).style.display = 'none'; // block
        }

        const odkry = ["trasy", "id_nazad"];
        for (let i = 0; i < odkry.length; i++) {
            document.getElementById(odkry[i]).style.display = 'block'; // block
        }
        document.getElementById('trasy').innerHTML = `<p class="text-gray-600">Vyhľadávam spojenia...</p>`;

        let r = document.getElementById('radius').value;
        if (!r) r = 500;

        const mode = document.getElementById("time_mode").value; // odchod / prichod

        let time = document.getElementById('time').value;
        if (!time) time = '00:00:00';

        let pocet_prestupovani = document.getElementById('max_prestupov').value;
        if (!pocet_prestupovani) pocet_prestupovani = 0;

        let datum_cesty = document.getElementById('datum_cesty').value
        if (!datum_cesty) {
            const rok = new Date().getFullYear();
            let mesiac = (new Date().getMonth() + 1);
            if (mesiac >= 1 && mesiac <= 9) {
                mesiac = "0" + mesiac
            }
            let den = new Date().getDate()
            if (den >= 1 && den <= 9) {
                den = "0" + den
            }
            datum_cesty = rok + "-" + mesiac + "-" + den;
        }

        try {
            const response = await fetch(search_connection_url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': getCookie('csrftoken')
                },
                body: JSON.stringify({
                    start: start,
                    end: end,
                    radius: r,
                    time_mode: mode,
                    pocet_prestupovani: pocet_prestupovani,
                    time: time,
                    datum_cesty: datum_cesty
                }),
                signal: signal,
            });
            document.getElementById('trasy').innerHTML = ``;
            const data = await response.json();
            if (!response.ok) {
                console.error(data.error)
                document.getElementById('trasy').innerText = `Nastala chyba pri počítaní trasy.`
                return;
            } else if (response.ok && data.no_connection) {
                document.getElementById('trasy').innerHTML += `<p>${data.no_connection}</p>`;
                return;
            } else if (response.ok && data.direct_walk) {
                let vzdialenost;
                if (data.distance == radius) {
                    vzdialenost = radius;
                } else if (data.distance == 0) {
                    vzdialenost = 0;
                } else {
                    vzdialenost = parseInt(data.distance) + 1
                }
                let vzdialenost_text;
                switch (vzdialenost) {
                    case 0:
                        vzdialenost_text = "0 metrov";
                        break;
                    case 1:
                        vzdialenost_text = vzdialenost + " meter";
                        break;
                    case 2:
                    case 3:
                    case 4:
                        vzdialenost_text = vzdialenost + " metre";
                        break;
                    default:
                        vzdialenost_text = vzdialenost + " metrov";
                        break;
                }

                const casove_trvanie = data.distance == 0 ? 0 : parseInt(data.duration / 60) + 1;
                let casove_trvanie_text;
                switch (casove_trvanie) {
                    case 0:
                        casove_trvanie_text = "0 minút";
                        break;
                    case 1:
                        casove_trvanie_text = casove_trvanie + " minútu";
                        break;
                    case 2:
                    case 3:
                    case 4:
                        casove_trvanie_text = casove_trvanie + " minúty";
                        break;
                    default:
                        casove_trvanie_text = casove_trvanie + " minút";
                        break;
                }

                document.getElementById('trasy').innerHTML += `<p>Zvolený začiatok a koniec sú v pešej dostupnosti:<br>
                    ${vzdialenost_text}, čo pešo zaberie ${casove_trvanie_text}</p>`;
                polyline.forEach(line => {
                    map.removeLayer(line);
                });

                polyline = [];

                const pl = L.polyline(data.coords, { color: "black", weight: '2', dashArray: '20, 10' }).addTo(map);
                polyline.push(pl);

                const group = L.featureGroup(polyline);
                map.fitBounds(group.getBounds());
                return;
            }

            const filtrovane = data.filtrovane_cesty;
            const zoznam_filtrovanych_tras = [];
            for (let i = 0; i < filtrovane.length; i++) {
                const pocet_prestupov = filtrovane[i][2];
                const filtrovana_trasa = [];
                filtrovana_trasa.push(pocet_prestupov);
                
                for (let j = 0; j < filtrovane[i][0].length; j += 1) {
                    if (filtrovane[i][0][j] === "VIRTUAL_START" || filtrovane[i][0][j] === "VIRTUAL_END") {
                        continue;
                    }

                    const trip_id = filtrovane[i][0][j][0];
                    const duration = filtrovane[i][0][j + 1][0];
                    const departure_time = filtrovane[i][0][j + 2][0];
                    const route = filtrovane[i][0][j + 3][0];
                    const next_stop = filtrovane[i][0][j + 4][0];
                    j += 4;
                    filtrovana_trasa.push([next_stop, departure_time, duration, route, trip_id]);
                }

                zoznam_filtrovanych_tras.push(filtrovana_trasa);
            }


            if (zoznam_filtrovanych_tras.length == 0) {
                document.getElementById('trasy').innerHTML += `<p>Nenašli sa žiadne trasy, ktoré by vyhovovali zvoleným kritériám.</p>`;
            } else {
                window._trasy_cache = [...zoznam_filtrovanych_tras]

                if (mode === "prichod") {
                    zobraz_trasy_prichod(zoznam_filtrovanych_tras);
                } else if (mode === "odchod") {
                    zobraz_trasy_odchod(zoznam_filtrovanych_tras);
                }
            }
        } catch (error) {
            if (error.name === 'AbortError') {
                // console.log("Vyhľadávanie bolo zrušené používateľom.");
            } else {
                console.error(error);
            }
        } finally {
            search_controller = null;
        }
    }

    function calculate_duration(first, second) { // time difference... hh:mm:ss - hh:mm:ss
        second = second.split(":")
        first = first.split(":")

        if (second.length == 2 && first.length == 2) {
            h_2 = parseInt(second[0]) * 3600
            m_2 = parseInt(second[1]) * 60
            time_2 = h_2 + m_2

            h_1 = parseInt(first[0]) * 3600
            m_1 = parseInt(first[1]) * 60
            time_1 = h_1 + m_1

            if (time_1 > time_2) {
                time_2 += 24 * 60 * 60
            }

            return time_2 - time_1;
        } else if (second.length == 3 && first.length == 3) {
            h_2 = parseInt(second[0]) * 3600
            m_2 = parseInt(second[1]) * 60
            s_2 = parseInt(second[2])
            time_2 = h_2 + m_2 + s_2

            h_1 = parseInt(first[0]) * 3600
            m_1 = parseInt(first[1]) * 60
            s_1 = parseInt(first[2])
            time_1 = h_1 + m_1 + s_1

            if (time_1 > time_2) {
                time_2 += 24 * 60 * 60
            }

            return time_2 - time_1;
        }
        return 0;
    }

