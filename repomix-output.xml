    function format_time(time, include_hours, include_minutes, include_seconds) {
        if (time >= 60 * 60 * 24) {
            time = time - 60 * 60 * 24;
        } else if (time < 0) {
            time = time + 60 * 60 * 24;
        }
        const cas = seconds_to_time_format(time);
        if (cas[0] >= 0 && cas[0] <= 9) {
            cas[0] = "0" + cas[0];
        }

        if (cas[1] >= 0 && cas[1] <= 9) {
            cas[1] = "0" + cas[1];
        }

        if (cas[2] >= 0 && cas[2] <= 9) {
            cas[2] = "0" + cas[2];
        }

        if (include_hours) {
            if (include_minutes) {
                if (include_seconds) {
                    return cas[0] + ":" + cas[1] + ":" + cas[2];
                }
                return cas[0] + ":" + cas[1]
            }
            return cas[0] + ":" + cas[1] + ":" + cas[2];
        }

        if (include_minutes) {
            if (include_seconds) {
                return cas[1] + ":" + cas[2];
            }
            return cas[1]
        }

        return cas[2];
    }

    function rozbal_kartu(index) {
        const detailEl = document.getElementById("detaily_" + index);
        const arrowEl = document.getElementById("sipka_" + index);

        if (!detailEl || !arrowEl) {
            console.log("Chýba karta alebo šípka pre index:", index);
            return;
        }

        if (open_card === index) {
            detailEl.classList.add("hidden");
            arrowEl.classList.remove("rotate-180");
            open_card = null;
            polyline.forEach(line => map.removeLayer(line));
            polyline = [];
            return;
        }

        if (open_card !== null) {
            const prevDetailEl = document.getElementById("detaily_" + open_card);
            const prevArrowEl = document.getElementById("sipka_" + open_card);

            if (prevDetailEl) prevDetailEl.classList.add("hidden");
            if (prevArrowEl) prevArrowEl.classList.remove("rotate-180");

            open_card = null;
            polyline.forEach(line => map.removeLayer(line));
            polyline = [];
        }

        detailEl.classList.remove("hidden");
        arrowEl.classList.add("rotate-180");
        open_card = index;

        const mode = document.getElementById("time_mode").value;
        switch (mode) {
            case "odchod":
                zobraz_trasu(index, window._trasy_cache[index], "odchod");
                break;
            case "prichod":
                zobraz_trasu(index, window._trasy_cache[index], "prichod");
                break;
        }
    }

    async function zobraz_trasu(index, trasa, mode) {
        let segments = []
        var start_stop = null;
        var end_stop;
        var trip = null;
        var pridane = false;
        for (let i = 1; i < trasa.length; i++) {
            if (start_stop == null) {
                start_stop = trasa[i][0];
                continue;
            }

            if (String(trasa[i][0]).toUpperCase() === 'V') {
                if (!pridane) {
                    if (end_stop == null) {
                        end_stop = trasa[trasa.length - 2][0];
                    } else if (start_stop == null) {
                        start_stop = trasa[2][0];
