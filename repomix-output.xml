        w_k_min = prvok_s_t_min[3]
        route_id = prvok_s_t_min[4]
        departure_time = prvok_s_t_min[5]
        cas_v_MDH = prvok_s_t_min[6]
        trip_id = prvok_s_t_min[7]
        
        pocet_prestupov_doteraz = None
        obsahuje_dva_pesie_useky_po_sebe = False
