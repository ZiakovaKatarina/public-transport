<file path="frontend/templates/hladanie_spojeni.html">
{% extends "base.html" %}
{% load static %}
{% block content %}

<div class="mx-auto max-w-5xl text-center justify-center rounded-xl">
    <p class="text-2xl w-full pb-3">Hľadanie spojenia</p>
    <div class="inline-flex items-start gap-3">
        <div class="self-start items-center gap-3 grid grid-cols-[50px_100px_180px]">
            <p class="text-right">Odkiaľ:</p>
            <input readonly type="text" id="zaciatocna"
                class="text-xs col-span-2 cursor-not-allowed rounded focus:outline-none focus:ring-0 focus:border-gray-500">
            <p class="text-right">Kam:</p>
            <input readonly type="text" id="koncova"
                class="text-xs col-span-2 cursor-not-allowed rounded focus:outline-none focus:ring-0 focus:border-gray-500">
            <div id="buttons_for_locations" class="col-span-3 justify-self-center">
                <button id="zmenit_start"
                    class="btn btn-sm text-xs w-[120px] mr-2 bg-white outline-green-900 border-green-900 text-green-900 hover:bg-[#b1d3be] hover:outline-[#b1d3be] hover:border-[#b1d3be]">Zmeniť
                    začiatok</button>
                <button id="zmenit_koniec"
                    class="btn btn-sm text-xs w-[120px] bg-white outline-red-800 border-red-800 text-red-800 hover:bg-[#ebb7b7] hover:outline-[#ebb7b7] hover:border-[#ebb7b7]">Zmeniť
                    koniec</button>
            </div>
            <div id="buttons_for_current_locations" class="col-span-3 justify-self-center">
                <button id="start_sucasna_poloha"
                    class="btn text-xs w-[145px] mr-2 bg-white outline-green-900 border-green-900 text-green-900 hover:bg-[#b1d3be] hover:outline-[#b1d3be] hover:border-[#b1d3be]">
                    Zvoliť súčasnú polohu ako začiatok</button>
                <button id="koniec_sucasna_poloha"
                    class="btn text-xs w-[145px] bg-white outline-red-800 border-red-800 text-red-800 hover:bg-[#ebb7b7] hover:outline-[#ebb7b7] hover:border-[#ebb7b7]">
                    Zvoliť súčasnú polohu ako koniec</button>
            </div>
            <p id="text_pocet_prestupov" class="text-right text-sm col-span-2">Počet prestupov:</p>
            <input type="number" value="5" id="max_prestupov" min="0" max="10"
                class="w-20 text-sm rounded focus:outline-none focus:ring-0 focus:border-green-900">
        <p id="text_datum" class="text-right text-sm col-span-2">Dátum cesty:</p>
            <input type="date" id="datum_cesty"
                class="w-[180px] text-sm rounded focus:outline-none focus:ring-0 focus:border-green-900">
            <div id="nejaky_div" class="w-20 justify-self-end text-sm mr-8 col-span-2">
                <select name="kedy" id="time_mode"
                    class="rounded text-sm focus:outline-none focus:ring-0 focus:border-green-900">
                    <option value="odchod">Odchod</option>
                    <option value="prichod">Príchod</option>
                </select>
            </div>
            <input type="time" id="time"
                class=" w-28 rounded text-sm focus:outline-none focus:ring-0 focus:border-green-900">
            <p id="text_vzdialenost_peso" class="text-right col-span-2">Vzdialenosť pešo:</p>
            <div id="nastavit_vzdialenost" class="flex flex-row gap-2 items-center">
                <input type="number" id="radius" min="0" value="500"
                    class="w-28 rounded text-sm focus:outline-none focus:ring-0 focus:border-green-900">
                <p id="metrov" class="text-sm ">metrov</p>
            </div>
            
            <button id="podme_hladat" type="button"
                class="mt-2 mb-1 justify-self-center text-nowrap col-span-3 w-[120px] h-[40px]
                       btn btn-sm text-xs transition hover:bg-[#2c6542] hover:outline-[#2c6542] hover:border-[#2c6542]
                       hover:text-yellow-300 bg-green-900 outline-green-900 border-green-900 text-white"
                onclick="search_connections()">Vyhľadaj trasy</button>
            
        <div id="trasa" class="justify-center col-span-3 font-semibold text-red-800"></div>
            
            <div id="trasy"
                class="border items-start border-gray-100 bg-gray-50 p-2 rounded h-[329px] w-[353px] col-span-3 overflow-auto">
            </div>
            <button id="id_nazad" onclick="chcem_vyhladat_spojenie()"
                class="btn btn-sm text-xs w-[200px] h-[40px] mr-2 bg-white outline-green-900 border-green-900 text-green-900 hover:bg-[#b1d3be] hover:outline-[#b1d3be] hover:border-[#b1d3be]">Návrat
                na vyhľadanie spojenia</button>
        </div>

        <div class="self-start">
            <div class="border-solid h-[480px] border w-[600px] border-black rounded" id="map"></div>
        </div>
    </div>
</div>

<script>
    var mapElement = document.getElementById('map');
    let selected_locations = [[null, null], [null, null]];
    let start_marker = null;
    let end_marker = null;
    let change_start = false;
    let change_end = false;
    let vyhladavanie_trasy = false;
    const date_input = document.getElementById('datum_cesty');
    const time_input = document.getElementById('time');
    const today = new Date().toISOString().split('T')[0];
    const time = new Date().toTimeString().slice(0, 5);
    date_input.value = today;
    time_input.value = time;
    const items = ["a", "b", "c"]
    const search_connection_url = "{% url 'data_management:search_connections' %}"
    const walking_distance_url = "{% url 'data_management:calculate_distance' %}"
    const suradnice_mhd_trasy_url = "{% url 'data_management:suradnice_mhd_trasy' %}"
    const zisti_adresu_url = "{% url 'data_management:zisti_adresu' %}"
    let polyline = [];
    let open_card = null;
    let pesie_coordinates = [];
    let search_controller = null;

    const schovat = ["trasy", "id_nazad"];
    for (let i = 0; i < schovat.length; i++) {
        document.getElementById(schovat[i]).style.display = 'none'; // block
    }

    const start_sucasna_poloha = document.getElementById('start_sucasna_poloha');
    start_sucasna_poloha.addEventListener('click', function () {
        if (change_end) {
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
            change_end = false;
            document.getElementById('zmenit_koniec').textContent = 'Zmeniť koniec';
            typ_zmeny_koniec = 'zmenit_koniec';
        }

        if (change_start) {
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
            change_start = false;
            document.getElementById('zmenit_start').textContent = 'Zmeniť začiatok';
            typ_zmeny_start = 'zmenit_zaciatok';
        }

        navigator.geolocation.getCurrentPosition(
            function(position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                
                if (start_marker) {
                    map.removeLayer(start_marker);
                    start_marker = null;
                }

                start_marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                const marker = start_marker.getElement();
                if (marker) {
                    marker.classList.add("green-marker");
                }

                start_marker.on('dragend', () => zisti_adresu('zaciatocna', start_marker));
                zisti_adresu('zaciatocna', start_marker);
            },
            function(error) {
                console.log(error.code);
            },
            {
                enableHighAccuracy: true,
                maximumAge: 50000,
                setTimeout: 10000
            }
        );
    });

    const end_sucasna_poloha = document.getElementById('koniec_sucasna_poloha');
    end_sucasna_poloha.addEventListener('click', function () {
        if (change_end) {
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
            change_end = false;
            document.getElementById('zmenit_koniec').textContent = 'Zmeniť koniec';
            typ_zmeny_koniec = 'zmenit_koniec';
        }

        if (change_start) {
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
            change_start = false;
            document.getElementById('zmenit_start').textContent = 'Zmeniť začiatok';
            typ_zmeny_start = 'zmenit_zaciatok';
        }

        navigator.geolocation.getCurrentPosition(
            function(position) {
                lat = position.coords.latitude;
                lng = position.coords.longitude;

                if (end_marker) {
                    map.removeLayer(end_marker);
                    end_marker = null;
                }

                end_marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                const marker = end_marker.getElement();
                if (marker) {
                    marker.classList.add("red-marker");
                }

                end_marker.on('dragend', () => zisti_adresu('koncova', end_marker));
                zisti_adresu('koncova', end_marker);
            },
            function(error) {
                console.log(error.code);
            },
            {
                enableHighAccuracy: true,
                setTimeout: 10000
            }
        );

        
    });

    const zmenit_start = document.getElementById('zmenit_start');
    let aplikuj_zmeny_start = false;
    let typ_zmeny_start = null;
    zmenit_start.addEventListener('click', function () {
        if (change_end) {
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            document.getElementById('zmenit_koniec').dispatchEvent(new MouseEvent('mouseleave', { bubbles: true, cancelable: true }));
        }

        change_start = !change_start;

        aplikuj_zmeny_start = true;
        if (change_start) {
            zmenit_start.textContent = 'Koniec zmien';
            typ_zmeny_start = 'koniec_zmien';
        } else {
            zmenit_start.textContent = 'Zmeniť začiatok';
            typ_zmeny_start = 'zmenit_zaciatok';
        }

        if (start_marker && start_marker.dragging) {
            if (change_start) {
                start_marker.dragging.enable();
            } else {
                start_marker.dragging.disable();
            }
        }
    });

    zmenit_start.addEventListener("mouseleave", function () {
        const btn = document.getElementById('zmenit_start');
        if (aplikuj_zmeny_start) {
            if (typ_zmeny_start === "koniec_zmien") {
                btn.classList.remove("bg-white", "outline-green-900", "border-green-900", "hover:bg-[#b1d3be]", "hover:outline-[#b1d3be]", "hover:border-[#b1d3be]");
                btn.classList.add("bg-[#b1d3be]", "outline-[#b1d3be]", "border-[#b1d3be]", "hover:bg-white", "hover:outline-green-900", "hover:border-green-900");
            } else if (typ_zmeny_start === "zmenit_zaciatok") {
                btn.classList.remove("bg-[#b1d3be]", "outline-[#b1d3be]", "border-[#b1d3be]", "hover:bg-white", "hover:outline-green-900", "hover:border-green-900");
                btn.classList.add("bg-white", "outline-green-900", "border-green-900", "hover:bg-[#b1d3be]", "hover:outline-[#b1d3be]", "hover:border-[#b1d3be]");
            }
        }
        aplikuj_zmeny_start = false;
    });

    const zmenit_koniec = document.getElementById('zmenit_koniec');
    let aplikuj_zmeny_koniec = false;
    let typ_zmeny_koniec = null;
    zmenit_koniec.addEventListener('click', function () {
        if (change_start) {
            document.getElementById('zmenit_start').dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
