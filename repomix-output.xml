            } else if (trip != null && trasa[i][4] != trip) {
                if (!pridane) {
                    if (end_stop == null) {
                        end_stop = trasa[i-1][0];
                    }
                    if (mode === "odchod") {
                        segments.push({ "start_stop": start_stop, "end_stop": end_stop, "trip": trip });    
                    } else if (mode === "prichod") {
                        segments.push({ "start_stop": end_stop, "end_stop": start_stop, "trip": trip });  
                    }
                }

                pridane = true;
                start_stop = trasa[i-1][0];
                end_stop = trasa[i][0];
                trip = trasa[i][4];
                pridane = false;
            }
        }

        const response = await fetch(suradnice_mhd_trasy_url, {
