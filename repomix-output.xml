                            hover:text-yellow-300 bg-green-900 outline-green-900 border-green-900 text-white
                            " onclick="load_zip_file()">Načítaj ZIP súbory</button>
            </div>
            <p id="warnings_zip" class="font-semibold mt-3" style="color: red;"></p>
        </div>
    </div>
    
    

        <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
        <script>
            const load_multiple_files_url = "{% url 'data_management:load_files' %}"

            function getCookie(name) {
                let cookieValue = null;
                if (document.cookie && document.cookie !== '') {
                    const cookies = document.cookie.split(';');
                    for (let i = 0; i < cookies.length; i++) {
                        const cookie = cookies[i].trim();
                        if (cookie.substring(0, name.length + 1) === (name + '=')) {
                            cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                            break;
                        }
                    }
                }
            return cookieValue;
        }

        async function load_zip_file() {
            
            let warn = false;
            document.getElementById('warnings_txt').innerHTML = '';
            document.getElementById('warnings_zip').innerHTML = '';

            const zip_file = document.getElementById('gtfs');
            if (!zip_file.files.length) {
                document.getElementById('warnings_zip').innerHTML += 'Vyber GTFS.zip súbor.';
                warn = true;
            }

            if (warn) {
                return;
            }

            const form_data = new FormData();
            let loaded_files = []

            try {
const jszip = new JSZip();
            const zip = await jszip.loadAsync(zip_file.files[0]);
            const filenames = Object.keys(zip.files);
            for (let index = 0; index < filenames.length; index++) {
const filename = filenames[index];
            const file = zip.files[filename];
            if (file.dir) {
                continue;
            };
            if (["agency.txt", "routes.txt", "trips.txt","stop_times.txt",
            "calendar.txt","calendar_dates.txt","stops.txt","shapes.txt","locations.geojson"].includes(filename)) {
                const content  = await file.async('blob');
                form_data.append(file.name.replace('.txt', '_file').replace('.geojson', '_file'), content);
                loaded_files.push(file.name);
            }
            }
            let count_povinne = 0;
            let obsahuje_calendar = false;
            
            loaded_files.forEach(element => {
                if (["agency.txt", "routes.txt", "trips.txt","stop_times.txt", "stops.txt"].includes(element)) {
                    count_povinne++;
                    return;
                } else if (["calendar.txt","calendar_dates.txt"].includes(element)) {
                    obsahuje_calendar = true;
                    return;
                }
            });

            if (count_povinne === 5 && obsahuje_calendar) {
                const response = await fetch(load_multiple_files_url, {
                method: 'POST',
                headers: {
                    'X-CSRFToken': getCookie('csrftoken')
                },
                body: form_data,
            });
            } else {
                document.getElementById('warnings_zip').innerHTML += 'Vybraný ZIP súbor neobsahoval všetky povinné súbory.';
            }

            } catch (err) {
                console.error(err)
            }
        }

        async function load_files() {
            let warn = false;
            document.getElementById('warnings_txt').innerHTML = '';
            document.getElementById('warnings_zip').innerHTML = '';

            const agency_file = document.getElementById('agency_file');
            if (!agency_file.files.length) {
                document.getElementById('warnings_txt').innerHTML += 'Vyber agency_file.txt súbor. ';
                warn = true;
            }

            const routes_file = document.getElementById('routes_file');
            if (!routes_file.files.length) {
                document.getElementById('warnings_txt').innerHTML += 'Vyber routes_file.txt súbor. ';
                warn = true;
            }

            const trips_file = document.getElementById('trips_file');
            if (!trips_file.files.length) {
                document.getElementById('warnings_txt').innerHTML += 'Vyber trips_file.txt súbor. ';
                warn = true;
            }

            const stop_times_file = document.getElementById('stop_times_file');
            if (!stop_times_file.files.length) {
                document.getElementById('warnings_txt').innerHTML += 'Vyber stop_times_file.txt súbor. ';
                warn = true;
            }

            const calendar_file = document.getElementById('calendar_file');
            const calendar_dates_file = document.getElementById('calendar_dates_file');
            if (!calendar_file.files.length && !calendar_dates_file.files.length) {
                document.getElementById('warnings_txt').innerHTML += 'Vyber aspoň jeden zo súborov ' +
                    'calendar_file.txt a calendar_dates_file.txt. ';
                warn = true;
            }

            const stops_file = document.getElementById('stops_file');
            const locations_file = document.getElementById('locations_file');
            if (!stops_file.files.length && !locations_file.files.length) {
                document.getElementById('warnings_txt').innerHTML += 'Vyber aspoň jeden zo súborov ' +
                    'stops_file.txt a locations_file.json.';
                warn = true;
            }

            if (warn) {
                return;
            }

            const formData = new FormData();
            formData.append('agency_file', agency_file.files[0]);
            formData.append('routes_file', routes_file.files[0]);
            formData.append('trips_file', trips_file.files[0]);
            formData.append('stop_times_file', stop_times_file.files[0]);

            if (calendar_file.files.length) {
                formData.append('calendar_file', calendar_file.files[0]);
            }

            if (calendar_dates_file.files.length) {
                formData.append('calendar_dates_file', calendar_dates_file.files[0]);
            }

            if (stops_file.files.length) {
                formData.append('stops_file', stops_file.files[0]);
            }

            if (locations_file.files.length) {
                formData.append('locations_file', locations_file.files[0]);
            }

            const shapes_file = document.getElementById('shapes_file');
            if (shapes_file.files.length) {
                formData.append('shapes_file', shapes_file.files[0]);
            }

            const response = await fetch(load_multiple_files_url, {
                method: 'POST',
                headers: {
                    'X-CSRFToken': getCookie('csrftoken')
                },
                body: formData,
            });
        }
    </script>
